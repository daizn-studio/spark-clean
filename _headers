/*
  # ---- Clickjacking ----
  # Stops your site being loaded inside an <iframe> on someone else's
  # domain, which is how "invisible overlay" scams trick people into
  # clicking a real Pay button they can't see.
  X-Frame-Options: DENY

  # ---- MIME sniffing ----
  # Stops browsers second-guessing a file's declared type. Without it, a
  # customer-uploaded photo could in some setups be interpreted as script.
  X-Content-Type-Options: nosniff

  # ---- Referrer ----
  # Send the origin only, never the full URL. Booking URLs can carry a
  # booking reference; this keeps that out of other sites' analytics.
  Referrer-Policy: strict-origin-when-cross-origin

  # ---- Permissions ----
  # The site needs the camera (photo capture). It has no use for the
  # microphone, geolocation, or payment-handler APIs, so they stay off.
  Permissions-Policy: camera=(self), microphone=(), geolocation=(), payment=()

  # ---- HSTS ----
  # After the first visit, the browser refuses to load this site over
  # plain HTTP, even if someone is tampering with the connection.
  # NOTE: only enable once HTTPS is confirmed working on your domain.
  # Rolling this back is slow, because browsers cache it for max-age.
  Strict-Transport-Security: max-age=31536000; includeSubDomains

  # ---- Content Security Policy ----
  # The real defence against script injection: even if a malicious script
  # reached the page, the browser refuses to run it unless it comes from
  # a source named here.
  #
  # 'unsafe-inline' is present because this site uses small inline
  # <script> blocks and inline style attributes. Removing it is the single
  # biggest hardening step left, and needs those moved into .js/.css files
  # first — see README "Tightening the CSP".
  #
  # Netlify serves this file (it must be named _headers, and the rule
  # above must be /* — a bare / only matches the homepage).
  #
  # Keep this in step with the identical policy in vercel.json — whichever
  # host serves the site, the site has to load the same things. These two
  # had already drifted once: this file allowed *.tile.openstreetmap.org
  # while js/map.js actually loads tiles from *.basemaps.cartocdn.com, so
  # the map rendered blank wherever this file was the live policy.
  #
  # media-src is listed explicitly because it does NOT inherit from
  # img-src — without it the homepage's background videos fall back to
  # default-src 'self' and are blocked.
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://js.stripe.com https://cdn.jsdelivr.net https://unpkg.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://unpkg.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https://*.supabase.co https://tile.openstreetmap.org https://images.pexels.com; media-src 'self' blob: https://videos.pexels.com; connect-src 'self' https://*.supabase.co https://api.stripe.com https://nominatim.openstreetmap.org; frame-src https://js.stripe.com https://hooks.stripe.com; frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'self'

# The admin portal should never be indexed by search engines.
/admin/*
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store
